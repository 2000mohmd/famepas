# FamePass — frontend environment variables
#
# Copy this file to `.env` and fill in the values from your own backend project.
# All three values are PUBLIC (they ship in the browser bundle); data access is
# protected by Row Level Security, never by hiding these values.
#
# On Lovable Cloud the real `.env` is generated for you when the backend is
# connected — you do not need to create it by hand.

# Backend (Supabase) project ref, e.g. abcdefghijklmnopqrst
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Project API URL, e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable / anon key (safe for the browser)
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# ---------------------------------------------------------------------------
# Server-side secrets are NEVER read from this file. They are configured as
# edge-function secrets in the backend dashboard:
#   SUPABASE_SERVICE_ROLE_KEY (managed automatically)
#   RESEND_API_KEY            (transactional email)
#   LOVABLE_API_KEY           (AI gateway, managed automatically)
#   GOOGLE_MAPS_API_KEY       (served via the google-maps-key function)
#   RAPIDAPI_KEY              (social profile / post metrics scraping)
#   ADMIN_EMAIL               (destination for signup notifications)
# ---------------------------------------------------------------------------
